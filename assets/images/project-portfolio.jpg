<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad10" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad10)"/>
  
  <!-- Code editor simulation -->
  <rect x="80" y="60" width="640" height="300" fill="#111111" stroke="#123c7c" stroke-width="2" rx="8"/>
  
  <!-- Editor header -->
  <rect x="80" y="60" width="640" height="35" fill="#1a1a1a" rx="8 8 0 0"/>
  <circle cx="100" cy="77" r="4" fill="#ff6b6b"/>
  <circle cx="115" cy="77" r="4" fill="#ffd93d"/>
  <circle cx="130" cy="77" r="4" fill="#4ecdc4"/>
  <text x="200" y="82" font-family="monospace" font-size="12" fill="#888888">index.html</text>
  
  <!-- Code lines -->
  <g font-family="monospace" font-size="11" fill="#00ff88">
    <text x="100" y="110">&lt;!DOCTYPE html&gt;</text>
    <text x="100" y="128">&lt;html lang="fr"&gt;</text>
    <text x="120" y="146">&lt;head&gt;</text>
    <text x="140" y="164">&lt;title&gt;Portfolio&lt;/title&gt;</text>
    <text x="140" y="182">&lt;link rel="stylesheet" href="style.css"&gt;</text>
    <text x="120" y="200">&lt;/head&gt;</text>
    <text x="120" y="218">&lt;body&gt;</text>
    <text x="140" y="236">&lt;nav&gt;...&lt;/nav&gt;</text>
    <text x="140" y="254">&lt;main&gt;...&lt;/main&gt;</text>
    <text x="120" y="272">&lt;/body&gt;</text>
    <text x="100" y="290">&lt;/html&gt;</text>
  </g>
  
  <!-- Syntax highlighting accents -->
  <g fill="#4ecdc4" opacity="0.3">
    <rect x="80" y="320" width="640" height="2"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="400" font-family="Arial" font-size="28" fill="#ffffff" text-anchor="middle" font-weight="bold">
    Personal Portfolio
  </text>
  <text x="400" y="430" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    HTML • CSS • JavaScript
  </text>
</svg>
