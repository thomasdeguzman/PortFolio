<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad3)"/>
  
  <!-- Title background -->
  <rect x="100" y="150" width="600" height="150" fill="#111111" opacity="0.3" rx="10"/>
  
  <!-- Shock absorber visualization -->
  <g stroke="#ffd93d" stroke-width="3" fill="none">
    <!-- Main blade structure -->
    <path d="M 250 200 L 280 280 L 320 280 L 290 200 Z"/>
    <path d="M 340 200 L 370 280 L 410 280 L 380 200 Z"/>
    <path d="M 430 200 L 460 280 L 500 280 L 470 200 Z"/>
    <path d="M 520 200 L 550 280 L 590 280 L 560 200 Z"/>
  </g>
  
  <!-- Stress visualization -->
  <circle cx="270" cy="240" r="25" fill="#ff6b6b" opacity="0.4"/>
  <circle cx="360" cy="240" r="25" fill="#ff6b6b" opacity="0.4"/>
  <circle cx="450" cy="240" r="25" fill="#ffd93d" opacity="0.4"/>
  <circle cx="540" cy="240" r="25" fill="#4ecdc4" opacity="0.4"/>
  
  <!-- Arrows indicating force -->
  <g stroke="#ffffff" stroke-width="2" opacity="0.8">
    <line x1="400" y1="120" x2="400" y2="180" marker-end="url(#arrowwhite)"/>
    <line x1="400" y1="330" x2="400" y2="390" marker-end="url(#arrowwhite)"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="240" font-family="Arial" font-size="26" fill="#ffffff" text-anchor="middle" font-weight="bold">
    Shock Absorber FEA
  </text>
  <text x="400" y="270" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    Abaqus | Structural Analysis
  </text>
  
  <defs>
    <marker id="arrowwhite" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#ffffff"/>
    </marker>
  </defs>
</svg>
