<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad5)"/>
  
  <!-- 2D Heat map -->
  <defs>
    <pattern id="heatPattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="40" height="40" fill="#4ecdc4"/>
      <rect x="40" y="0" width="40" height="40" fill="#6dd5cb"/>
      <rect x="80" y="0" width="40" height="40" fill="#95e1d3"/>
      <rect x="120" y="0" width="40" height="40" fill="#ffd93d"/>
      <rect x="160" y="0" width="40" height="40" fill="#ffb347"/>
      <rect x="0" y="40" width="40" height="40" fill="#6dd5cb"/>
      <rect x="40" y="40" width="40" height="40" fill="#95e1d3"/>
      <rect x="80" y="40" width="40" height="40" fill="#ffd93d"/>
      <rect x="120" y="40" width="40" height="40" fill="#ffb347"/>
      <rect x="160" y="40" width="40" height="40" fill="#ff6b6b"/>
    </pattern>
  </defs>
  
  <!-- Domain -->
  <rect x="150" y="120" width="500" height="200" fill="url(#heatPattern)"/>
  <rect x="150" y="120" width="500" height="200" stroke="#ffffff" stroke-width="2" fill="none"/>
  
  <!-- Grid -->
  <g stroke="#ffffff" stroke-width="0.5" opacity="0.2">
    <line x1="150" y1="140" x2="650" y2="140"/>
    <line x1="150" y1="160" x2="650" y2="160"/>
    <line x1="150" y1="180" x2="650" y2="180"/>
    <line x1="150" y1="200" x2="650" y2="200"/>
    <line x1="150" y1="220" x2="650" y2="220"/>
    <line x1="150" y1="240" x2="650" y2="240"/>
    <line x1="150" y1="260" x2="650" y2="260"/>
    <line x1="150" y1="280" x2="650" y2="280"/>
    <line x1="170" y1="120" x2="170" y2="320"/>
    <line x1="250" y1="120" x2="250" y2="320"/>
    <line x1="330" y1="120" x2="330" y2="320"/>
    <line x1="410" y1="120" x2="410" y2="320"/>
    <line x1="490" y1="120" x2="490" y2="320"/>
    <line x1="570" y1="120" x2="570" y2="320"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="380" font-family="Arial" font-size="28" fill="#ffffff" text-anchor="middle" font-weight="bold">
    Heat Equation 2D
  </text>
  <text x="400" y="410" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    Fortran90 | 2D Simulation
  </text>
</svg>
