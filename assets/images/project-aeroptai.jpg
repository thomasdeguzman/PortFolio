<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad9" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad9)"/>
  
  <!-- Browser window -->
  <rect x="100" y="80" width="600" height="280" fill="#f5f7fa" stroke="#123c7c" stroke-width="2" rx="8"/>
  
  <!-- Browser header -->
  <rect x="100" y="80" width="600" height="30" fill="#123c7c" rx="8 8 0 0"/>
  <circle cx="120" cy="95" r="4" fill="#ff6b6b"/>
  <circle cx="135" cy="95" r="4" fill="#ffd93d"/>
  <circle cx="150" cy="95" r="4" fill="#4ecdc4"/>
  
  <!-- Content area -->
  <rect x="110" y="115" width="300" height="120" fill="#ffffff" stroke="#dfe4ea" stroke-width="1"/>
  <rect x="420" y="115" width="260" height="120" fill="#ffffff" stroke="#dfe4ea" stroke-width="1"/>
  
  <!-- Placeholder content -->
  <g fill="#dfe4ea">
    <rect x="120" y="125" width="280" height="12" rx="3"/>
    <rect x="120" y="145" width="240" height="8" rx="2"/>
    <rect x="120" y="160" width="200" height="8" rx="2"/>
    <rect x="120" y="175" width="220" height="8" rx="2"/>
    <rect x="120" y="190" width="160" height="8" rx="2"/>
  </g>
  
  <!-- Chart visualization -->
  <g fill="#123c7c" opacity="0.6">
    <rect x="435" y="200" width="20" height="30"/>
    <rect x="465" y="185" width="20" height="45"/>
    <rect x="495" y="170" width="20" height="60"/>
    <rect x="525" y="195" width="20" height="35"/>
    <rect x="555" y="180" width="20" height="50"/>
  </g>
  
  <!-- AI indicator -->
  <circle cx="680" cy="160" r="25" fill="#00ff88" opacity="0.2"/>
  <text x="680" y="168" font-family="Arial" font-size="10" fill="#00ff88" text-anchor="middle" font-weight="bold">AI</text>
  
  <!-- Text -->
  <text x="400" y="400" font-family="Arial" font-size="28" fill="#ffffff" text-anchor="middle" font-weight="bold">
    AerOptAI Platform
  </text>
  <text x="400" y="430" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    Web Interface | Data Visualization
  </text>
</svg>
