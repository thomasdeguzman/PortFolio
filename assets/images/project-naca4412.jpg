<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad2)"/>
  
  <!-- Mesh visualization -->
  <g stroke="#00ff88" stroke-width="0.5" opacity="0.4">
    <line x1="100" y1="100" x2="700" y2="100"/>
    <line x1="100" y1="150" x2="700" y2="150"/>
    <line x1="100" y1="200" x2="700" y2="200"/>
    <line x1="100" y1="250" x2="700" y2="250"/>
    <line x1="100" y1="300" x2="700" y2="300"/>
    <line x1="100" y1="350" x2="700" y2="350"/>
  </g>
  
  <!-- NACA 4412 airfoil -->
  <path d="M 150 225 Q 260 130 400 120 Q 520 120 600 190 Q 650 240 600 290 Q 520 360 400 360 Q 260 350 150 225" 
        fill="#123c7c" opacity="0.3" stroke="#ffffff" stroke-width="3"/>
  
  <!-- Velocity field -->
  <circle cx="250" cy="150" r="35" fill="#ff6b6b" opacity="0.2"/>
  <circle cx="550" cy="150" r="35" fill="#4ecdc4" opacity="0.2"/>
  <circle cx="550" cy="300" r="35" fill="#4ecdc4" opacity="0.2"/>
  
  <!-- Vector field -->
  <g stroke="#ffd93d" stroke-width="1.5" opacity="0.6">
    <line x1="280" y1="140" x2="310" y2="140" marker-end="url(#arrow1)"/>
    <line x1="280" y1="200" x2="310" y2="200" marker-end="url(#arrow1)"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="380" font-family="Arial" font-size="28" fill="#ffffff" text-anchor="middle" font-weight="bold">
    NACA 4412 Analysis
  </text>
  <text x="400" y="410" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    Numerical Simulation | CFD
  </text>
  
  <defs>
    <marker id="arrow1" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#ffd93d"/>
    </marker>
  </defs>
</svg>
