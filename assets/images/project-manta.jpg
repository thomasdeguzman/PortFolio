<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad7" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad7)"/>
  
  <!-- Underwater visualization -->
  <circle cx="400" cy="220" r="180" fill="#4ecdc4" opacity="0.1"/>
  
  <!-- Submarine drone MANTA -->
  <g fill="none" stroke="#00ff88" stroke-width="3">
    <!-- Main body -->
    <ellipse cx="400" cy="220" rx="100" ry="60"/>
    <!-- Fins -->
    <path d="M 330 220 L 300 180"/>
    <path d="M 470 220 L 500 180"/>
    <path d="M 330 220 L 300 260"/>
    <path d="M 470 220 L 500 260"/>
  </g>
  
  <!-- Water flow -->
  <g stroke="#00ff88" stroke-width="1.5" opacity="0.5">
    <path d="M 150 150 Q 200 120 250 150" fill="none" marker-end="url(#arrow2)"/>
    <path d="M 150 220 Q 200 220 250 220" fill="none" marker-end="url(#arrow2)"/>
    <path d="M 150 290 Q 200 320 250 290" fill="none" marker-end="url(#arrow2)"/>
  </g>
  
  <!-- Sensor points -->
  <circle cx="380" cy="210" r="5" fill="#ffd93d"/>
  <circle cx="420" cy="210" r="5" fill="#ffd93d"/>
  
  <!-- Text -->
  <text x="400" y="380" font-family="Arial" font-size="28" fill="#ffffff" text-anchor="middle" font-weight="bold">
    MANTA Drone
  </text>
  <text x="400" y="410" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    Hydrodynamic & Structural Study
  </text>
  
  <defs>
    <marker id="arrow2" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
      <polygon points="0 0, 10 3, 0 6" fill="#00ff88"/>
    </marker>
  </defs>
</svg>
