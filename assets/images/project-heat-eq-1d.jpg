<svg width="800" height="450" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123c7c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d2a5a;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="heatGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#4ecdc4;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#ffd93d;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff6b6b;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad4)"/>
  
  <!-- Domain -->
  <rect x="150" y="180" width="500" height="80" fill="url(#heatGrad)" opacity="0.8"/>
  
  <!-- Grid lines -->
  <g stroke="#ffffff" stroke-width="1" opacity="0.3">
    <line x1="150" y1="170" x2="150" y2="270"/>
    <line x1="200" y1="170" x2="200" y2="270"/>
    <line x1="250" y1="170" x2="250" y2="270"/>
    <line x1="300" y1="170" x2="300" y2="270"/>
    <line x1="350" y1="170" x2="350" y2="270"/>
    <line x1="400" y1="170" x2="400" y2="270"/>
    <line x1="450" y1="170" x2="450" y2="270"/>
    <line x1="500" y1="170" x2="500" y2="270"/>
    <line x1="550" y1="170" x2="550" y2="270"/>
    <line x1="600" y1="170" x2="600" y2="270"/>
    <line x1="650" y1="170" x2="650" y2="270"/>
  </g>
  
  <!-- Temperature points -->
  <circle cx="150" cy="220" r="6" fill="#4ecdc4"/>
  <circle cx="250" cy="220" r="6" fill="#ffd93d"/>
  <circle cx="400" cy="220" r="6" fill="#ffd93d"/>
  <circle cx="650" cy="220" r="6" fill="#ff6b6b"/>
  
  <!-- Text -->
  <text x="400" y="360" font-family="Arial" font-size="28" fill="#ffffff" text-anchor="middle" font-weight="bold">
    Heat Equation 1D
  </text>
  <text x="400" y="390" font-family="Arial" font-size="16" fill="#ffffff" opacity="0.8" text-anchor="middle">
    Fortran90 | Finite Differences
  </text>
</svg>
